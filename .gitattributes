# Line endings, decided at checkout time.
#
# Windows checkouts default to core.autocrlf=true, which rewrites text files to CRLF as
# they land on disk. `npm run build:bundle` then regenerates bundle/dist with LF, and the
# CI step that diffs the rebuild against the committed bundle sees every line as changed —
# so the build fails on Windows for a reason that has nothing to do with the code.
#
# Setting core.autocrlf in a workflow step cannot fix this: the checkout has already
# happened by the time any step runs, and the conversion is done. This file is the only
# place that applies early enough.
* text=auto eol=lf

# Bundled output is generated by tsc, which writes LF. Stated separately so that a future
# change to the blanket rule does not quietly reintroduce the CRLF diff.
bundle/dist/** text eol=lf

# Shell scripts must keep LF even on a Windows checkout, or the shebang stops working.
*.sh text eol=lf

# Binary. `text=auto` would otherwise try to normalise these, and a corrupted PNG is a
# worse failure than a noisy diff.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.xlsx binary
*.xls binary
*.pdf binary
*.woff binary
*.woff2 binary
